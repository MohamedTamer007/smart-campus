# Reference ONLY for the MonsterASP.NET website Scripting > Environment variables panel.
# Do NOT upload this file, commit actual secret values, or use the example placeholders.
# A free MonsterASP.NET site is a test/evaluation environment only.
# Real student registration, private user data and university-wide release are NOT approved.
#
# Never put credentials in GitHub Actions build artifacts or published web.config.
# ASPNETCORE_ENVIRONMENT must not be Development on a publicly accessible website.

ASPNETCORE_ENVIRONMENT=Production
PublicOrigin=https://smartcampus.tryasp.net/
AllowedHosts=smartcampus.tryasp.net

# Existing Supabase app schema (8 EF migrations already applied).
# Create a dedicated runtime role without CREATE/ALTER/DROP or public-schema access.
# Require verified certificate TLS and review the actual session-pooler endpoint.
ConnectionStrings__Campus=Host=SET_VERIFIED_POOLER_HOST;Port=5432;Database=postgres;Username=SET_SCOPED_RUNTIME_ROLE;Password=SET_IN_HOST_SECRET_PANEL;SSL Mode=VerifyFull;Maximum Pool Size=5;Timeout=15;Command Timeout=30;Search Path=smart_campus,extensions,public

# The two existing Supabase media buckets are private. Never make them public.
# Only a server-side scoped key, after review of storage-prefix access policy.
Storage__Local=false
Storage__Url=https://mninpcrhqsaafoshjqpn.supabase.co
Storage__Key=SET_SERVER_ONLY_STORAGE_KEY

# An authorized HTTPS email sender is required for verified accounts.
# Free Resend test-sender mail works only for the owner inbox, not real students.
Email__Provider=resend
Email__LocalSink=false
Email__From=SET_VERIFIED_AUTHORIZED_SENDER
Email__ResendKey=SET_RESEND_HTTPS_KEY

# Use access-restricted, permanent directories OUTSIDE the site's public wwwroot.
# The example paths are intentionally unresolved: verify the actual IIS private path.
DataProtection__Directory=SET_EXISTING_PRIVATE_WINDOWS_DIRECTORY_FOR_KEYS
DataProtection__CertificatePath=SET_EXISTING_PRIVATE_WINDOWS_PATH_TO_PFX
DataProtection__CertificatePassword=SET_CERTIFICATE_SECRET

# Keep AI features externally gated pending an independently hosted Python model.
AI__Provider=openrouter
AI__AllowNonSensitiveInference=false
AI__AllowNonSensitiveImages=false
Search__CalibrationApproval=

# A controlled test release must contain ONLY explicitly approved university
# test mailboxes; never fabricate an owner or enable university-wide registration.
Release__Mode=controlled
Release__AllowedEmails__0=SET_APPROVED_TEST_EMAIL_AT_O6U.EDU.EG

# No worker can run persistently on MonsterASP.NET Free.
# Enable search only after a separate private worker and tested calibration.
Deployment__Commit=SET_VERIFIED_GITHUB_COMMIT
