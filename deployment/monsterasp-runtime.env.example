# MonsterASP.NET Free is ONLY for synthetic-data demos, development and evaluation.
# MonsterASP.NET Terms §3.2 prohibit production personal-data processing.
# Do NOT point this free site at the existing live student database or Storage bucket.
# Set each variable in Website > Scripting > Environment variables; DO NOT upload
# this file, paste live credentials into GitHub, or store keys in web.config.
# All SET_* placeholders require separate manual configuration in the host's secret panel.

ASPNETCORE_ENVIRONMENT=Production
PublicOrigin=https://smartcampus.tryasp.net/
AllowedHosts=smartcampus.tryasp.net
Release__Mode=university
# Any exact @o6u.edu.eg account may register; email verification is required before sign-in.
# This template is for synthetic evaluation only; MonsterASP Free must not process real student data.

# Isolated evaluation PostgreSQL 17 schema (NOT the existing production schema).
# The database server's CA must validate via VerifyFull on MonsterASP.NET Windows.
# Never disable TLS verification to make the connection work.
ConnectionStrings__Campus=Host=SET_TEST_POOLER_HOST;Port=5432;Database=postgres;Username=SET_TEST_RUNTIME_ROLE;Password=SET_PRIVATE_TEST_ROLE_PASSWORD;SSL Mode=VerifyFull;Maximum Pool Size=5;Timeout=15;Command Timeout=30;Search Path=smart_campus,extensions,public

Storage__Local=false
Storage__Url=https://SET_ISOLATED_TEST_SUPABASE_PROJECT.supabase.co
Storage__Key=SET_SERVER_ONLY_TEST_STORAGE_KEY

# Only a sender explicitly authorized and Verified in the provider should be used.
Email__Provider=brevo
Email__LocalSink=false
Email__From=SET_BREVO_VERIFIED_SENDER
Email__BrevoKey=SET_NEW_PRIVATE_BREVO_API_V3_KEY
Email__BrevoSenderVerified=true
Email__TestRecipient=SET_APPROVED_TEST_MAILBOX

# MonsterASP.NET Free official guidance: persisted Data Protection XML keys
# belong in the app-writable /private/keys sibling of /wwwroot.
# IIS app pools do not have a Windows user profile, so DPAPI or a PFX import
# can fail at startup. The private folder is NOT web-accessible and survives
# deployments, though keys are not encrypted at rest by the application.
Hosting__Platform=monsterasp
DataProtection__Store=monsterasp-private
# The former DataProtection__CertificateBase64 and
# DataProtection__CertificatePassword variables are unnecessary in this mode.
# Once the site starts successfully, remove unused PFX variables from the host.
# Back up the /private/keys folder securely before migrating providers.

# Fixed maintenance routing: text and staff-approved images ->
# OpenRouter Nemotron 3.5 Super VL free variant.
# Lost/found embeddings -> direct Google Gemini Embedding 2 (768 dimensions).
# Keep all external processing, images and reindexing off until privacy review.
AI__Provider=openrouter
AI__AllowNonSensitiveInference=false
AI__AllowNonSensitiveImages=false
# Operator-triggered admin synthetic prompt only; DO NOT enable on a personal-data host.
AI__SyntheticSmokeTestsEnabled=false
# Only for allowlisted verified users on a separate controlled test release.
# Limits: one attempt per user/day; three attempts total/day (UTC).
AI__SyntheticUserSmokeTestsEnabled=false
AI__OpenRouterKey=SET_PRIVATE_OPENROUTER_KEY
AI__OpenRouterDailyRequestLimit=50
AI__OpenRouterRequestsPerMinute=20
# Maintenance classification stays on OpenRouter's exact :free model with no paid fallback.
# Supply a reviewed taxonomy before AI use: AI__FaultTypes__0,
# AI__Priorities__0 and AI__Risks__0.

# Google Gemini Embedding 2 Free Tier. Ensure Google Cloud billing is disabled;
# this flag cannot detect or enforce project billing status.
AI__GeminiKey=SET_PRIVATE_GEMINI_KEY
AI__GeminiFreeTierOnly=false
AI__GeminiDailyRequestLimit=50
AI__GeminiRequestsPerMinute=10
# Off by default pending provider privacy review, billing verification and calibration.
Search__Provider=hosted
Search__ExternalProcessingApproved=false
Search__ExternalImagesApproved=false
Search__GeminiExternalProcessingApproved=false
Search__GeminiExternalImagesApproved=false
Search__GeminiProviderDataCollection=deny
Search__GeminiReindexApproved=false
Search__GeminiReindexGeneration=0
Search__CalibrationApproval=
Search__CalibrationRevision=
# Keep both hosted thresholds unset until independently reviewed calibration.
# Search__TextMinimumScore=SET_REVIEWED_TEXT_THRESHOLD
# Search__ImageMinimumScore=SET_REVIEWED_IMAGE_ONLY_THRESHOLD
# Search__MultimodalMinimumScore=SET_REVIEWED_IMAGE_QUERY_THRESHOLD

Deployment__Commit=SET_VERIFIED_GITHUB_COMMIT
