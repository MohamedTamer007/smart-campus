# Copy outside Git to a restricted file. Every SET_ value must be configured securely.
PublicOrigin=https://SET_FREE_HTTPS_HOSTNAME
AllowedHosts=SET_FREE_HTTPS_HOSTNAME
ConnectionStrings__Campus=Host=SET_SESSION_POOLER_HOST;Port=5432;Database=postgres;Username=SET_RUNTIME_ROLE;Password=SET_RUNTIME_SECRET;SSL Mode=VerifyFull;Maximum Pool Size=15;Timeout=15;Command Timeout=30;Search Path=smart_campus,extensions,public
Storage__Local=false
Storage__Url=https://mninpcrhqsaafoshjqpn.supabase.co
Storage__Key=SET_BACKEND_STORAGE_SECRET
Email__Provider=smtp
Email__LocalSink=false
Email__From=SET_AUTHORIZED_SENDER
Email__Host=SET_APPROVED_SMTP_HOST
Email__Port=587
Email__Username=SET_SMTP_USERNAME_IF_REQUIRED
Email__Password=SET_SMTP_SECRET_IF_REQUIRED
# For Resend, select resend, set its key, and verify a controlled sender domain first.
# Optional EmailJS trial (server-side only). Do NOT enable without
# connecting your own authorized Gmail/Outlook/transactional sender in EmailJS,
# setting the template's "To Email" to {{to_email}}, and verifying real inbox delivery.
# Create the template using {{subject}} and {{link}} fields, with the link
# visible as a clickable URL. EmailJS acceptance does not prove delivery.
# Email__Provider=emailjs
# Email__EmailJsServiceId=SET_SERVICE_ID
# Email__EmailJsTemplateId=SET_TEMPLATE_ID
# Email__EmailJsPublicKey=SET_EMAILJS_PUBLIC_KEY
# Email__EmailJsPrivateKey=SET_PRIVATE_EMAILJS_KEY
# Email__EmailJsTrialApproved=true
# EmailJS free allowance is for limited trials, not guaranteed campus mail.

Email__ResendKey=
DataProtection__Directory=/var/lib/smart-campus/keys
DataProtection__CertificatePath=/run/secrets/data-protection.pfx
DataProtection__CertificatePassword=SET_PRIVATE_CERTIFICATE_SECRET
AI__Provider=openrouter
AI__AllowNonSensitiveInference=false
AI__AllowNonSensitiveImages=false
# Add AI__OpenRouterKey or AI__NvidiaKey only through secure host configuration.
AI__OpenRouterDailyRequestLimit=50
AI__OpenRouterRequestsPerMinute=20
AI__NvidiaDailyRequestLimit=0
AI__NvidiaRequestsPerMinute=5
# Add reviewed AI__FaultTypes__0, AI__Priorities__0, AI__Risks__0 etc through secure configuration.
Search__WorkerUrl=http://127.0.0.1:8123/
Search__WorkerKey=SET_RANDOM_WORKER_KEY_AT_LEAST_32_CHARACTERS
Search__CalibrationApproval=
# Add Search__MinimumScore only after reviewed real-model calibration.
Deployment__Commit=SET_VERIFIED_COMMIT
Release__Mode=controlled
# Set Release__AllowedEmails__0 etc to actual authorized university test mailboxes.
# Open release requires separate approval and a recorded Release__UniversityApproval reference.

# Optional Brevo HTTPS transactional email API (no outbound SMTP port required).
# Add an authorized sender in Brevo, verify your own sender domain and confirm
# delivery to a university mailbox before enabling production mail.
# Email__Provider=brevo
# Email__BrevoKey=SET_PRIVATE_BREVO_API_V3_KEY
# Email__BrevoSenderVerified=true
# Keep Email__From set to the exact sender registered in Brevo.
# Brevo API and SMTP keys differ; for Brevo SMTP instead use the existing
# Email__Provider=smtp, Email__Host=smtp-relay.brevo.com, Email__Port=587
# (STARTTLS), Email__Username=<Brevo SMTP login> and Email__Password=<SMTP key>.
# Do not enter an SMTP key in Email__BrevoKey.
